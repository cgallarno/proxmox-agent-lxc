[Unit]
Description=AI agent gateway (hardened, non-root)
After=network-online.target user@@OC_UID@.service
Wants=network-online.target user@@OC_UID@.service

[Service]
Type=simple
# Runs as the dedicated non-root agent user — NEVER root.
User=@OC_USER@
Group=@OC_USER@
Environment=HOME=@OC_HOME@
Environment=NODE_ENV=production
Environment=PATH=@AGENT_PATH@
Environment=XDG_RUNTIME_DIR=/run/user/@OC_UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@OC_UID@/bus
WorkingDirectory=@OC_HOME@
ExecStart=@AGENT_CMD@ gateway
Restart=on-failure
RestartSec=5

# Note: this unit controls the default Hermes profile only. Additional Hermes
# profiles should be run as systemd *system* instances via
# agent-gateway@<profile>.service, not via `hermes --profile <p> gateway start`,
# because the durable control plane is system-level. The provisioner enables a
# narrow lingering user manager so Hermes can place cron workers in transient
# user scopes without giving the agent system-level systemd control.

# Hardening — least privilege for an exec-capable agent on untrusted input.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# Keep home trees read-only while allowing access to /run/user/<uid>/bus for
# Hermes' restart-safe user-scoped cron workers.
ProtectHome=read-only
ReadWritePaths=@OC_HOME@
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
